# Copy this file to .env and fill in your own key.
# Used only by the local dev server (server/rulesApiPlugin.ts,
# server/bookTranscriptionPlugin.ts) to call the Anthropic API for parsing a
# book's rules text and transcribing pages — it never reaches the browser.
ANTHROPIC_API_KEY=

# Optional: override the model used for rules extraction and page
# transcription (defaults to claude-opus-5). Both are bounded structured-
# extraction tasks, so a cheaper model may work fine — worth trying if
# you're optimizing for cost.
# ANTHROPIC_MODEL=
